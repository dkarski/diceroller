{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "pull-request-title-pattern": "chore(release): v${version}",
  "draft": true,
  "force-tag-creation": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "New"
    },
    {
      "type": "fix",
      "section": "Fixes"
    },
    {
      "type": "perf",
      "section": "Improvements"
    },
    {
      "type": "refactor",
      "section": "Code",
      "hidden": true
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Maintenance",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "package-name": "diceroller",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "1.0.0"
    }
  },
  "bootstrap-sha": "44022340ee7972597817733caec1ea83cdbcf0e3"
}
