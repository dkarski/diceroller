    <string name="privacy_links_title">ਲਿੰਕ</string>
    <string name="privacy_links">ਸੰਪਰਕ ਪਤਾ ਸਿਰਫ਼ ਤੁਹਾਡੀ ਈਮੇਲ ਐਪ ਖੋਲ੍ਹਦਾ ਹੈ ਜਾਂ ਪਤਾ ਕਾਪੀ ਕਰਦਾ ਹੈ। ਟਿੱਪ ਸਿਰਫ਼ ਦੂਜੇ ਫ਼ੋਨ ਨਾਲ ਸਕੈਨ ਕਰਨ ਲਈ ਕੋਡ ਦਿਖਾਉਂਦੀ ਹੈ। ਉੱਥੇ ਜੋ ਹੁੰਦਾ ਹੈ, ਉਹ ਇਸ ਐਪ ਤੋਂ ਬਾਹਰ ਹੈ।</string>
    <string name="terms_free_title">ਮੁਫ਼ਤ ਅਤੇ ਬਿਨਾਂ ਵਾਰੰਟੀ</string>
