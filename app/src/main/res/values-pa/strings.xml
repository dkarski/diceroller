    <string name="privacy_offline_title">ਆਫ਼ਲਾਈਨ ਵਰਤੋਂ</string>
    <string name="privacy_offline">%1$s ਨੈੱਟਵਰਕ ਤੋਂ ਬਿਨਾਂ ਚੱਲਦੀ ਹੈ। ਇਸ ਕੋਲ ਇੰਟਰਨੈੱਟ ਦੀ ਇਜਾਜ਼ਤ ਨਹੀਂ ਅਤੇ ਇਹ ਕਦੇ ਵੀ ਕਿਤੇ ਕਨੈਕਟ ਨਹੀਂ ਹੁੰਦੀ।</string>
    <string name="privacy_permissions_title">ਇਜਾਜ਼ਤਾਂ</string>
