    <string name="privacy_offline_title">ஆஃப்லைன் பயன்பாடு</string>
    <string name="privacy_offline">%1$s நெட்வொர்க் இல்லாமல் இயங்கும். இதற்கு இணைய அனுமதி இல்லை, இது எங்கும் இணைவதில்லை.</string>
    <string name="privacy_permissions_title">அனுமதிகள்</string>
    <string name="privacy_permissions">ஆப் எந்த அனுமதியும் கேட்காது.</string>
    <string name="privacy_links_title">இணைப்புகள்</string>
    <string name="privacy_links">தொடர்பு முகவரி உங்கள் மின்னஞ்சல் ஆப்பைத் திறக்கும் அல்லது முகவரியை நகலெடுக்கும், அவ்வளவே. டிப்ஸ் வேறொரு ஃபோனால் ஸ்கேன் செய்ய ஒரு குறியீட்டை மட்டும் காட்டும். அங்கு நடப்பது இந்த ஆப்புக்கு வெளியே.</string>
    <string name="terms_free_title">இலவசம், உத்தரவாதம் இல்லை</string>
    <string name="terms_free">%1$s இலவசம், உள்ளது உள்ளபடி உத்தரவாதமின்றி வழங்கப்படுகிறது. டிப்ஸ் விருப்பமானது, எதையும் திறக்காது.</string>
    <string name="terms_liability_title">பொறுப்பு</string>
    <string name="terms_liability">சட்டம் அனுமதிக்கும் அளவுக்கு, ஆப்பைப் பயன்படுத்துவதால் ஏற்படும் சேதத்துக்கு டெவலப்பர் (%1$s, %2$s) பொறுப்பல்ல. நுகர்வோராக உங்கள் சட்ட உரிமைகள் பாதிக்கப்படாது.</string>
    <string name="licenses_intro">%1$s இந்த ஓப்பன் சோர்ஸ் பகுதிகளால் உருவானது:</string>
    <string name="license_text">உரிம உரை: %1$s</string>
    <string name="tip_jar_text">%1$s பிடித்திருக்கிறதா? %2$s-இல் டிப்ஸ் தர வேறொரு ஃபோனால் குறியீட்டை ஸ்கேன் செய்யுங்கள். டிப்ஸ் விருப்பமானது, எதையும் திறக்காது.</string>
