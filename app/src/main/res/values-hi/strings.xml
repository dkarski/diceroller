    <string name="privacy_offline_title">ऑफ़लाइन उपयोग</string>
    <string name="privacy_offline">%1$s बिना नेटवर्क के काम करता है। इसके पास इंटरनेट की अनुमति नहीं है और यह कभी कहीं कनेक्ट नहीं होता।</string>
    <string name="privacy_permissions_title">अनुमतियाँ</string>
    <string name="privacy_permissions">ऐप कोई अनुमति नहीं माँगता।</string>
    <string name="privacy_links_title">लिंक</string>
    <string name="privacy_links">संपर्क पता सिर्फ़ आपका ईमेल ऐप खोलता है या पता कॉपी करता है। टिप सिर्फ़ एक कोड दिखाता है जिसे दूसरे फ़ोन से स्कैन करना है। वहाँ जो होता है, वह इस ऐप से बाहर है।</string>
    <string name="terms_free_title">मुफ़्त और बिना वारंटी</string>
    <string name="terms_free">%1$s मुफ़्त है और जैसा है वैसा, बिना किसी वारंटी के दिया जाता है। टिप स्वैच्छिक है और कुछ भी अनलॉक नहीं करती।</string>
    <string name="terms_liability_title">दायित्व</string>
    <string name="terms_liability">कानून द्वारा अनुमत सीमा तक डेवलपर (%1$s, %2$s) ऐप के उपयोग से हुए नुकसान के लिए ज़िम्मेदार नहीं है। इससे उपभोक्ता के रूप में आपके कानूनी अधिकार प्रभावित नहीं होते।</string>
    <string name="licenses_intro">%1$s इन ओपन सोर्स हिस्सों से बना है:</string>
    <string name="license_text">लाइसेंस का पाठ: %1$s</string>
    <string name="tip_jar_text">%1$s पसंद आया? %2$s पर टिप देने के लिए कोड को दूसरे फ़ोन से स्कैन करें। टिप स्वैच्छिक है और कुछ भी अनलॉक नहीं करती।</string>
